rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an authenticated admin in Firestore
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true;
    }

    // Admin Users collection - Only accessible by authenticated active admins
    match /adminUsers/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Products collection:
    // Public can read only published products.
    // Admins can read and write all products.
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Product Categories:
    // Public read-only, Admin write
    match /productCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SEO Pages collection:
    // Public read-only, Admin write
    match /seoPages/{pageKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media metadata collection:
    // Admin only
    match /media/{mediaId} {
      allow read, write: if isAdmin();
    }

    // Activity Logs:
    // Admin only
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Inquiries:
    // Public client cannot read inquiries.
    // Creation is handled securely via server-side Next.js route handlers using Firebase Admin SDK.
    // If client writes directly, require validation; but standard architecture routes via Server.
    match /inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if false; // All form submissions are routed securely through Next.js backend with spam protection
      allow update, delete: if isAdmin();

      match /notes/{noteId} {
        allow read, write: if isAdmin();
      }
    }
  }
}
